.env
.venv/
__pycache__/
*.pyc
# The catalog carries the templates themselves -- names, categories, detected
# frames, effects -- so it belongs in the repository. Its write-ahead log and
# shared-memory files are transient and do not.
data/*.sqlite3-wal
data/*.sqlite3-shm
draft_templates/*
!draft_templates/.gitkeep
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep
logs/*
!logs/.gitkeep
sam2.1_l.pt
*.pt
*.pth
models/*
!models/.gitkeep
*.db

.claude/settings.local.json
